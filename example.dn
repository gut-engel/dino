};

console.log(dictionary.key[2]); //Outputs "Favorite food"
console.log(dictionary.value(2))//Outputs "noodles"
console.log(dictionary.valueOfKey[2]);//Outputs "noodles"
console.log(dictionary.valueOfKey["Age"]); //Outputs "15"

console.log(array[2]);//Outputs "Stefan"
console.log(array["Stefan"]);//Outputs 2
