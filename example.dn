const bool boolean = true;
const string array = ["John", "Alex", "Stefan"];
const dict dictionary = {"Name": "John", "Age": "15", "Favorite food": "noodles"};

func greet(string name) {
    console.log($"Greetings to {name}!\n");
};

if (boolean) {
    console.log("this is a log \n");
    console.warn("this is a warning \n");
    console.error("this is an error \n");
};

greet(input("type your name: "));

for (var i = 0; i<10; i++) {
    switch (i) {
        case (i<3) {
            console.log($"under 3: {i}\n");
        };
        case (i>3) {
            console.log($"over 3: {i}\n");
        };
        case (i==3) {
            console.log("i equals 3");
        };
    };
};

