{
  "name": "dino-language",
  "displayName": "Dino Language Support",
  "description": "Syntax highlighting, completions and language configuration for the Dino (.dn) programming language that transpiles to C.",
  "version": "0.1.2",
  "publisher": "dino",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:dino"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dino",
    "dn",
    "transpiler",
    "c",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dino",
        "aliases": [
          "Dino",
          "dino"
        ],
        "extensions": [
          ".dn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dino",
        "scopeName": "source.dino",
        "path": "./syntaxes/dino.tmLanguage.json"
      }
    ]
  }
}