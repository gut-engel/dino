{
  "name": "dino-language",
  "displayName": "Dino Language Support",
  "description": "Syntax highlighting, completions and language configuration for the Dino (.dn) programming language that transpiles to C.",
  "version": "0.1.5",
  "publisher": "dino",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:dino"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dino",
    "dn",
    "transpiler",
    "c",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dino",
        "aliases": [
          "Dino",
          "dino"
        ],
        "extensions": [
          ".dn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dino",
        "scopeName": "source.dino",
        "path": "./syntaxes/dino.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "invalid.illegal.dino",
            "settings": {
              "foreground": "#F44747"
            }
          },
          {
            "scope": "constant.character.escape.dino",
            "settings": {
              "foreground": "#E5C07B"
            }
          }
        ]
      },
      "[light]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "invalid.illegal.dino",
              "settings": {
                "foreground": "#C62828"
              }
            },
            {
              "scope": "constant.character.escape.dino",
              "settings": {
                "foreground": "#B58900"
              }
            }
          ]
        }
      }
    }
  }
}