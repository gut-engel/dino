{
  "For loop": {
    "prefix": "for",
    "body": [
      "for (var ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
      "\t${3}",
      "}"
    ],
    "description": "Dino for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "Dino while loop"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "Dino if statement"
  },
  "If / else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Dino if / else statement"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase (${2:condition}) {",
      "\t\t${3}",
      "\t};",
      "\tdefault {",
      "\t\t${0}",
      "\t};",
      "};"
    ],
    "description": "Dino switch statement (cases are runtime conditions)"
  },
  "Var declaration": {
    "prefix": "var",
    "body": "var ${1:name} = ${2:value};",
    "description": "Dino inferred variable declaration"
  },
  "Const declaration": {
    "prefix": "const",
    "body": "const ${1:type} ${2:name} = ${3:value};",
    "description": "Dino typed constant declaration"
  },
  "console.log": {
    "prefix": "log",
    "body": [
      "console.log(${1});"
    ],
    "description": "Print to stdout"
  },
  "console.warn": {
    "prefix": "warn",
    "body": [
      "console.warn(${1});"
    ],
    "description": "Print to stderr"
  },
  "console.error": {
    "prefix": "error",
    "body": [
      "console.error(${1});"
    ],
    "description": "Print to stderr"
  },
  "console.do": {
    "prefix": "do",
    "body": [
      "console.do(${1:command});"
    ],
    "description": "Run a shell command via system()"
  },
  "delay": {
    "prefix": "delay",
    "body": [
      "delay(${1:seconds});"
    ],
    "description": "Sleep for a whole or fractional number of seconds"
  }
}